<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="thor7v3">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import thor7v3 urdf file -->
    <xacro:include filename="$(find thor7v3_description)/urdf/thor7v3_robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="thor7v3.ros2_control.xacro" />


    <xacro:thor7v3_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
